# Highland deployment settings. `ops init` writes a copy of this file with strong random secrets filled in.
# Lines starting with # are optional: remove the # to use them. Never commit the real .env file.

# The app
# Name of this Compose project. Only change it if two deployments share one machine.
# COMPOSE_PROJECT_NAME=highland
# Which app image to run (our own, from the release you installed). Set by the release; `ops update` changes it.
# The default names (highland/app, highland/ops) are local only: they are loaded from a file (docker load, or
# `ops update --image-file`) and never downloaded, because those names on Docker Hub belong to someone else.
# To use a private registry, give the full name, such as registry.example.com/highland/app, and set IMAGE_PULL_POLICY=missing.
# APP_IMAGE=highland/app
# OPS_IMAGE=highland/ops
# IMAGE_PULL_POLICY=never
# APP_TAG=
# UPDATER_TAG=
# The name shown to staff in the app and in emails.
APP_NAME=
# The web address staff use, such as https://expenses.client.co.uk (http://... on a client LAN without HTTPS).
APP_ORIGIN=
# production for a live box. demo is for demonstrations with made-up data and must never hold real data.
INSTANCE_MODE=production
# The client's name, used in alerts so you can tell the boxes apart.
CLIENT_LABEL=
# Database password. Random; made by `ops init`.
DB_PASSWORD=
# Secret that lets the monitoring read the detailed health and version. Random; made by `ops init`.
HEALTH_TOKEN=
# What the front door (Caddy) answers to: :80 for plain HTTP on a LAN, or a public name for automatic HTTPS.
# If you use the tunnel this MUST be :80 (keep APP_ORIGIN as https://...), or visitors loop forever.
SITE_ADDRESS=:80
# The private network between the front door and the tunnel. Change it only if it clashes with a network you use.
# EDGE_SUBNET and TUNNEL_IP go together: change both together, or neither. TUNNEL_IP must be inside EDGE_SUBNET and must not be
# its first address (the network), its second (.1, the gateway, where traffic from the host arrives) or its last (broadcast).
# The edge-check service checks this before the front door starts: on a mismatch the front door stays down (backups carry on).
# EDGE_SUBNET=172.30.250.0/28
# The tunnel's fixed address on that network. Only this address is believed when it reports a visitor's real address.
# TUNNEL_IP=172.30.250.10
# The ports the front door listens on, if 80 and 443 are already in use.
# HTTP_PORT=80
# HTTPS_PORT=443
# The full path of the folder holding this file on the machine. The updater needs it.
HF_BUNDLE_DIR=

# Mail
# Where the app sends mail, such as smtp://user:password@smtp.example.co.uk:587
SMTP_URL=
# The sender address on invitation and password-reset emails.
EMAIL_FROM=

# Backups (where they go is set by the client's data policy)
# Where backups are stored, such as sftp:backup@host:/path, s3:s3.example.com/bucket or rest:https://host:8000/repo
BACKUP_REPOSITORY=
# The password that locks the backups. Random; made by `ops init`. Keep a copy off this machine.
BACKUP_PASSWORD=
# Only for development: allow a backup folder on this same machine. Never true on a live box.
# BACKUP_ALLOW_LOCAL=false
# When backups run (cron: minute hour day month weekday, UK time) and when a test restore runs.
# BACKUP_SCHEDULE=30 2 * * *
# RESTORE_TEST_SCHEDULE=30 4 * * 0
# How many old backups to keep.
# BACKUP_KEEP=--keep-daily 7 --keep-weekly 5 --keep-monthly 12
# How many days of the audit log to keep.
# AUDIT_RETENTION_DAYS=730
# Sign-in details for an S3-compatible backup destination.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Sign-in details for a Backblaze B2 backup destination.
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# Sign-in details for a password-protected restic REST server.
# RESTIC_REST_USERNAME=
# RESTIC_REST_PASSWORD=

# Alerts. Ops checks the box every minute and alerts on the second failure in a row, repeats every 6 hours, and says when
# it is fixed (after two good checks in a row). A live box (INSTANCE_MODE=production) will not start ops until Matrix or
# the webhook is set; every channel that is set gets every alert.
# Matrix room that gets the alerts: the server address, an access token for the alert bot, and the room id.
# MATRIX_HOMESERVER=
# MATRIX_ACCESS_TOKEN=
# MATRIX_ROOM_ID=
# Optional second route for alerts: a web address that receives each alert as a JSON message.
# ALERT_WEBHOOK_URL=
# Optional web address pinged every minute while ops is alive (Uptime Kuma push format, always status=up, with "OK" or a
# short summary of any problems as msg), so a dead-man's-switch service can tell you if this box goes silent.
# HEARTBEAT_URL=

# Remote access (outbound tunnel)
# Token from the tunnel provider's dashboard. Needs `--profile tunnel` when starting. Nothing is opened inbound.
# With the tunnel, set SITE_ADDRESS=:80 above (`ops init --tunnel` does this).
# TUNNEL_TOKEN=
# Set to true when the tunnel is in use, so the monitor watches it.
# TUNNEL_ENABLED=false

# Advanced
# (Nothing else is needed for a normal install. Extra settings for the app go in compose.override.yaml.)
