{
  "name": "@hf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./db": {
      "types": "./dist/db/client.d.ts",
      "default": "./dist/db/client.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema/index.d.ts",
      "default": "./dist/db/schema/index.js"
    }
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@hf/ocr": "0.1.0",
    "@hf/shared": "0.1.0",
    "@hf/pdf-export": "0.1.0",
    "@hf/xlsx-export": "0.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "build": "tsc -b",
    "seed:demo": "node dist/seed/cli.js",
    "seed:demo:dev": "tsx src/seed/cli.ts"
  }
